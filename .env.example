# generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# keep true for local dev only; false in production (enables HTTPS-only cookies, HSTS, SSL redirect)
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SSL_REDIRECT=true
ALLOW_REGISTRATION=true

POSTGRES_DB=research_copilot
POSTGRES_USER=research_copilot
POSTGRES_PASSWORD=research_copilot
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_HOST_PORT=6379

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# auto = use the keys below; demo = offline canned answers (no keys, no tokens)
LLM_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

DAILY_QUESTION_QUOTA=50

# optional error tracking
SENTRY_DSN=
